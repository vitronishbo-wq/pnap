# ==============================================================================
# PNAP - Modelo de Variáveis de Ambiente do Backend (Render / Desenvolvimento)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este ficheiro para ".env" para desenvolvimento local.
# 2. Em produção, configure estas variáveis no painel Environment do Render.
# 3. NUNCA insira credenciais reais neste ficheiro (.env.example) nem faça commit do .env.

# Porta HTTP do servidor Express (o Render injeta PORT automaticamente em produção)
PORT=3001

# Origens autorizadas para CORS (URLs do Firebase Hosting separadas por vírgula)
# Em local, use http://localhost:3000 (ou a porta do seu frontend)
FRONTEND_URL="https://pnap-gov.web.app,https://pnap-angola.web.app,https://gen-lang-client-0559607571.web.app"

# URL pública da API Express no Render (usada pelo frontend Vite em produção)
VITE_API_BASE_URL="https://pnap-api.onrender.com"

# URL pública onde este backend está hospedado (opcional / referência)
APP_URL="https://pnap-api.onrender.com"

# Chave secreta da API Gemini (exclusiva do backend)
GEMINI_API_KEY="sua-chave-api-gemini-aqui"

# Credenciais do Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID="seu-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ID da base de dados Firestore (obrigatório ao usar instância nomeada)
FIREBASE_DATABASE_ID="id-da-sua-instancia-firestore"
